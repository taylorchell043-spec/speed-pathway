 const skillRows=[['SkillShark Overall',a.skillOverall],['Hard Skills Score',a.hardSkills],['Hitting Eval 1',a.hit1],['Hitting Eval 2',a.hit2],['Infield Eval 1',a.in1],['Infield Eval 2',a.in2],['Outfield Eval 1',a.out1],['Outfield Eval 2',a.out2],['Pitching Score',a.pitchScore],['Catching Score',a.catchScore]].filter(x=>x[1]!=null).map(x=>`<div class="fit"><span>${x[0]}</span><strong>${fmt(x[1],1)}</strong></div>`).join("");
 document.getElementById("modalContent").innerHTML=`
 <div class="hero"><div class="avatar">${initials(a.name)}</div><div><h2>${a.name}</h2><div class="muted">${a.team} • ${a.grad||"Grad year not listed"} • ${a.position}</div><div style="margin-top:8px"><b>${a.hasSkills?'✓ SkillShark tryout data linked':'SkillShark scores not found for this athlete'}</b>${a.commitment?` • Commitment: ${a.commitment}`:''}</div></div></div>
 <div class="grid4">
   <div class="card stat"><div class="k">Roster GPA</div><div class="v">${a.gpa==null?'—':a.gpa}</div></div>
   <div class="card stat"><div class="k">Exit Velo</div><div class="v">${fmt(a.ev)}</div><div class="s">${a.hasSkills?'SkillShark tryout':'Not available'}</div></div>
   <div class="card stat"><div class="k">Overhand Velo</div><div class="v">${fmt(a.arm)}</div><div class="s">${a.hasSkills?'SkillShark tryout':'Not available'}</div></div>
   <div class="card stat"><div class="k">Home-to-1st</div><div class="v">${fmt(a.h1,2)}</div><div class="s">${a.hasSkills?'SkillShark tryout':'Not available'}</div></div>
 </div>
 <div class="detailgrid" style="margin-top:14px">
   <div class="card"><h3 style="margin-top:0">SkillShark Tryout Evaluation</h3>${a.hasSkills?(skillRows||'<div class="muted">Matched, but no scored categories were populated.</div>'):'<div class="muted">No exact name match was found in the uploaded SkillShark score export.</div>'}${a.pop!=null?`<div class="fit"><span>Catcher Pop Time</span><strong>${fmt(a.pop,2)} s</strong></div>`:''}</div>
   <div class="card"><h3 style="margin-top:0">Coach Evaluation — DEMO</h3>${coach}</div>
   <div class="card"><h3 style="margin-top:0">College Fit — DEMO</h3>${matches}</div>
   <div class="card"><h3 style="margin-top:0">Recruiting Readiness — DEMO</h3><div class="fit"><span>Concept score</span><strong>${a.readiness}%</strong></div><div class="progress"><span style="width:${a.readiness}%"></span></div><p class="muted">This is still placeholder presentation logic, not an evaluation of the athlete.</p></div>
 </div>
 <div class="card" style="margin-top:14px"><h3 style="margin-top:0">Next 3 Actions — DEMO</h3>${a.next.map((x,i)=>`<div class="task"><div class="check">${i+1}</div><div>${x}</div></div>`).join("")}</div>`;
 document.getElementById("modal").classList.remove("hidden");
}
function closeModal(){document.getElementById("modal").classList.add("hidden")}
function renderOverview(){
 document.getElementById("readyCount").textContent=athletes.filter(a=>a.readiness>=70).length;
 document.getElementById("interactionCount").textContent=athletes.reduce((s,a)=>s+a.interactions,0);
 document.getElementById("overviewRows").innerHTML=[...athletes].sort((a,b)=>Number(b.hasSkills)-Number(a.hasSkills)).slice(0,8).map(a=>`<tr><td><button class="nameBtn" onclick="openAthlete(${a.id})">${a.name}</button></td><td>${a.grad||"—"}</td><td>${a.position}</td><td>${a.hasSkills?fmt(a.skillOverall):"—"}</td><td><span class="badge ${a.hasSkills?"active":"building"}">${a.hasSkills?"SKILLS LINKED":"ROSTER ONLY"}</span></td></tr>`).join("");
}
function renderAthletes(){
 const q=document.getElementById("athSearch").value.toLowerCase(), t=document.getElementById("teamFilter").value, g=document.getElementById("gradFilter").value, s=document.getElementById("statusFilter").value;
 const filtered=athletes.filter(a=>(!q||a.name.toLowerCase().includes(q))&&(!t||a.team===t)&&(!g||String(a.grad)===g)&&(!s||a.status===s));
 document.getElementById("athleteCards").innerHTML=filtered.map(athleteCard).join("");
}
function resetFilters(){document.getElementById("athSearch").value="";document.getElementById("teamFilter").value="";document.getElementById("gradFilter").value="";document.getElementById("statusFilter").value="";renderAthletes()}
function renderCoach(){
 const g=document.getElementById("coachGrad").value,p=document.getElementById("coachPos").value,gpa=parseFloat(document.getElementById("coachGpa").value),r=parseInt(document.getElementById("coachReady").value);
 const f=athletes.filter(a=>(!g||String(a.grad)===g)&&(!p||a.position.includes(p))&&a.gpa>=gpa&&a.readiness>=r).sort((a,b)=>b.readiness-a.readiness);
 document.getElementById("coachResults").innerHTML=f.length?f.map(athleteCard).join(""):`<div class="card"><b>No matches.</b><div class="muted">Broaden the filters and search again.</div></div>`;
}
function renderCombine(){
 const top=athletes.filter(a=>a.ev!=null).sort((a,b)=>b.ev-a.ev).slice(0,8);
 document.getElementById("combineRows").innerHTML=top.map(a=>`<tr><td><button class="nameBtn" onclick="openAthlete(${a.id})">${a.name}</button></td><td>${a.ev}</td><td>${a.arm}</td><td>${a.h1}</td></tr>`).join("");
}
function renderReadiness(){
 document.getElementById("readinessRows").innerHTML=athletes.map(a=>{
  let prof=Math.min(100,a.readiness+randomOffset(a.id,5,15)), vid=Math.min(100,a.readiness+randomOffset(a.id+5,-4,12)), list=Math.max(35,a.readiness+randomOffset(a.id+10,-15,8)), comm=Math.max(25,a.readiness+randomOffset(a.id+20,-22,5));
  return `<tr><td><button class="nameBtn" onclick="openAthlete(${a.id})">${a.name}</button></td><td>${prof}%</td><td>${vid}%</td><td>${list}%</td><td>${comm}%</td><td><b>${a.readiness}%</b></td></tr>`
 }).join("");
}
function randomOffset(seed,min,max){let x=Math.sin(seed*999)*10000;let f=x-Math.floor(x);return Math.round(min+f*(max-min))}
document.querySelectorAll(".nav button").forEach(btn=>btn.addEventListener("click",()=>{
 document.querySelectorAll(".nav button").forEach(x=>x.classList.remove("active"));btn.classList.add("active");
 document.querySelectorAll(".page").forEach(x=>x.classList.add("hidden"));document.getElementById(btn.dataset.page).classList.remove("hidden");
 const names={overview:"Organization Dashboard",athletes:"Athlete Passports",coach:"College Coach Portal",combine:"Speed Verified Combine",readiness:"Recruiting Readiness",admin:"Program Admin"};
 document.getElementById("pageTitle").textContent=names[btn.dataset.page];
}));
["athSearch","teamFilter","gradFilter","statusFilter"].forEach(id=>document.getElementById(id).addEventListener("input",renderAthletes));
[...new Set(athletes.map(a=>a.team))].sort().forEach(t=>document.getElementById("teamFilter").insertAdjacentHTML("beforeend",`<option>${t}</option>`));
renderOverview();renderAthletes();renderCoach();renderCombine();renderReadiness();
</script>
</body></html>
