function stars(n){return "★".repeat(n)+"☆".repeat(5-n)}
function initials(name){return name.split(" ").map(x=>x[0]).join("").slice(0,2)}
function fmt(v,d=1){return (v===null||v===undefined||v==="")?"—":Number(v).toFixed(d).replace(/\.0$/,"")}
function athleteCard(a){
return `<div class="card athleteCard" onclick="openAthlete(${a.id})">
  <div style="display:flex;justify-content:space-between;gap:8px"><div><b>${a.name}</b><div class="muted">${a.team} • ${a.grad||"—"} • ${a.position}</div></div><span class="badge ${a.hasSkills?'active':'building'}">${a.hasSkills?'SKILLS LINKED':'NO SKILLS YET'}</span></div>
  <div class="metricrow"><div class="metric"><b>${fmt(a.ev)}</b><small>Exit Velo</small></div><div class="metric"><b>${fmt(a.arm)}</b><small>Overhand Velo</small></div><div class="metric"><b>${fmt(a.h1,2)}</b><small>Home-to-1st</small></div></div>
  <div class="fit"><span>SkillShark Overall</span><strong>${fmt(a.skillOverall)}${a.skillOverall!=null?' / 100':''}</strong></div>
</div>`}
