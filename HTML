<script>
const SPEED_SUPA_URL='https://rcisvivlhpdwwikoakmt.supabase.co';
const SPEED_SUPA_KEY='sb_publishable_WF7qqXdDuSld2wu1PQYJbQ_3h5avNvz';
const speedSb=supabase.createClient(SPEED_SUPA_URL,SPEED_SUPA_KEY);
const q=id=>document.getElementById(id);
function authShow(which){['loginPanel','signupPanel','pendingPanel'].forEach(id=>q(id).classList.toggle('hidden',id!==which));q('authGate').classList.remove('hidden');q('appRoot').classList.add('hidden');q('accountBar').classList.add('hidden')}
async function speedBoot(){const {data:{session}}=await speedSb.auth.getSession();if(!session){authShow('loginPanel');return}const {data:p,error}=await speedSb.from('profiles').select('display_name,role,approved').eq('id',session.user.id).single();if(error){q('authMsg').innerHTML='<span class="authError">Profile access error: '+error.message+'</span>';authShow('loginPanel');return}if(!p?.approved){authShow('pendingPanel');return}q('authGate').classList.add('hidden');q('appRoot').classList.remove('hidden');q('accountBar').classList.remove('hidden');q('accountWho').textContent=(p.display_name||session.user.email)+' • '+String(p.role||'user').replaceAll('_',' ').toUpperCase()}
q('authLogin').onclick=async()=>{q('authMsg').textContent='Signing in...';const {error}=await speedSb.auth.signInWithPassword({email:q('authEmail').value.trim(),password:q('authPassword').value});if(error){q('authMsg').innerHTML='<span class="authError">'+error.message+'</span>';return}q('authMsg').textContent='';speedBoot()};
q('authShowSignup').onclick=()=>authShow('signupPanel');q('authBack').onclick=()=>authShow('loginPanel');
q('authCreate').onclick=async()=>{const name=q('authName').value.trim(),email=q('authNewEmail').value.trim(),password=q('authNewPassword').value;if(!name||!email||password.length<6){q('authSignupMsg').innerHTML='<span class="authError">Enter full name, email and a password of at least 6 characters.</span>';return}q('authSignupMsg').textContent='Creating account...';const {data,error}=await speedSb.auth.signUp({email,password,options:{data:{display_name:name},emailRedirectTo:'https://taylorchell043-spec.github.io/speed-pathway/'}});if(error){q('authSignupMsg').innerHTML='<span class="authError">'+error.message+'</span>';return}if(data.session){q('authSignupMsg').textContent='Account created.';speedBoot()}else q('authSignupMsg').textContent='Account created. Check your email to confirm it, then return here and sign in.'};
q('accountOut').onclick=q('pendingOut').onclick=async()=>{await speedSb.auth.signOut();location.reload()};q('authPassword').addEventListener('keydown',e=>{if(e.key==='Enter')q('authLogin').click()});speedSb.auth.onAuthStateChange(()=>setTimeout(speedBoot,0));speedBoot();
