<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Speed Pathway — Midwest Speed Recruiting Platform</title>
<style>
:root{
  --bg:#0c0f12; --panel:#13181d; --panel2:#181f25; --line:#26313a;
  --text:#f4f7f9; --muted:#98a7b3; --green:#35d05b; --green2:#1ea944;
  --yellow:#f0c84b; --red:#ef6b6b; --blue:#58a6ff;
}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
button,input,select{font:inherit}
.shell{display:grid;grid-template-columns:245px 1fr;min-height:100vh}
.sidebar{background:#090b0d;border-right:1px solid var(--line);padding:20px 16px;position:sticky;top:0;height:100vh}
.brand{display:flex;align-items:center;gap:10px;margin-bottom:24px}
.brand img{width:58px;height:58px;object-fit:contain;background:white;border-radius:10px;padding:4px}
.brand h1{font-size:16px;margin:0;line-height:1.1}
.brand small{color:var(--green);font-weight:700}
.nav button{display:block;width:100%;text-align:left;background:transparent;border:0;color:#b8c3cc;padding:11px 12px;border-radius:8px;margin:4px 0;cursor:pointer}
.nav button:hover,.nav button.active{background:#152019;color:white}
.nav button.active{border-left:3px solid var(--green)}
.demoBox{position:absolute;left:16px;right:16px;bottom:18px;background:#1d241d;border:1px solid #314c33;padding:10px;border-radius:10px;font-size:11px;color:#b9d9bd}
.main{padding:0 28px 60px}
.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);margin-bottom:24px}
.topbar h2{margin:0;font-size:20px}
.pill{display:inline-flex;align-items:center;gap:7px;border:1px solid #35563a;background:#132016;padding:7px 11px;border-radius:999px;font-size:12px;color:#c8f0ce}
.dot{width:8px;height:8px;background:var(--green);border-radius:50%}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.card{background:linear-gradient(180deg,var(--panel),#10151a);border:1px solid var(--line);border-radius:14px;padding:18px}
.stat .k{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em}
.stat .v{font-size:30px;font-weight:800;margin-top:5px}
.stat .s{font-size:12px;color:var(--green);margin-top:5px}
.section-title{display:flex;align-items:end;justify-content:space-between;margin:28px 0 12px}
.section-title h3{margin:0;font-size:17px}
.section-title p{margin:0;color:var(--muted);font-size:12px}
.table{width:100%;border-collapse:collapse}
.table th{text-align:left;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.07em;padding:10px;border-bottom:1px solid var(--line)}
.table td{padding:12px 10px;border-bottom:1px solid #1d262d;font-size:13px}
.nameBtn{color:white;background:none;border:0;padding:0;font-weight:700;cursor:pointer}
.nameBtn:hover{color:var(--green)}
.progress{height:7px;background:#253039;border-radius:99px;overflow:hidden}
.progress span{display:block;height:100%;background:var(--green)}
.badge{padding:4px 8px;border-radius:99px;font-size:10px;font-weight:800}
.badge.active{background:#163a22;color:#80ee99} .badge.building{background:#3c3113;color:#f4d875}
.two{display:grid;grid-template-columns:1.25fr .75fr;gap:16px}
.searchrow{display:grid;grid-template-columns:1fr 210px 150px 160px 160px;gap:10px;margin-bottom:14px}
input,select{width:100%;background:#0e1418;color:white;border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.results{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.athleteCard{cursor:pointer;transition:.15s}
.athleteCard:hover{transform:translateY(-2px);border-color:#3b6d47}
.metricrow{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}
.metric{background:#0d1216;border:1px solid #202b33;padding:10px;border-radius:9px}
.metric b{font-size:17px} .metric small{display:block;color:var(--muted);margin-top:3px}
.fit{display:flex;align-items:center;justify-content:space-between;margin:8px 0;font-size:12px}
.fit strong{color:var(--green)}
.hidden{display:none!important}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:flex;align-items:center;justify-content:center;padding:25px;z-index:50}
.modalbox{width:min(1050px,96vw);max-height:92vh;overflow:auto;background:#0f1418;border:1px solid #34414a;border-radius:18px;padding:22px}
.modalhead{display:flex;justify-content:space-between;gap:12px;align-items:start}
.close{background:#202830;color:white;border:1px solid #34414a;border-radius:8px;padding:8px 11px;cursor:pointer}
.hero{display:flex;gap:18px;align-items:center;margin:12px 0 20px}
.avatar{width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#1e2c22;border:2px solid var(--green);font-size:26px;font-weight:900}
.hero h2{margin:0 0 5px} .muted{color:var(--muted)}
.detailgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.stars{color:var(--yellow);letter-spacing:2px}
.action{background:var(--green);color:#071008;border:0;border-radius:8px;padding:10px 13px;font-weight:800;cursor:pointer}
.action.secondary{background:#192127;color:white;border:1px solid #33404a}
.task{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid #202930}
.check{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#173b22;color:#84ef9a;font-weight:900}
.timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.phase{border:1px solid var(--line);border-radius:10px;padding:12px;background:#10161a}
.phase b{color:var(--green)}
.footer{color:#60717d;font-size:11px;margin-top:30px;text-align:center}
@media(max-width:900px){
 .shell{grid-template-columns:1fr} .sidebar{position:relative;height:auto} .nav{display:flex;overflow:auto;gap:4px}
 .nav button{min-width:max-content} .demoBox{position:static;margin-top:14px} .grid4,.results,.two,.detailgrid{grid-template-columns:1fr 1fr}
 .searchrow{grid-template-columns:1fr 1fr} .main{padding:0 14px 40px}
}
@media(max-width:600px){.grid4,.results,.two,.detailgrid,.searchrow,.timeline{grid-template-columns:1fr}}
@media print{.sidebar,.topbar .pill,.action,.close{display:none!important} .shell{display:block} .main{padding:0} body{background:white;color:black} .card,.modalbox{background:white;color:black;border:1px solid #bbb}}
</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
